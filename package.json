{
  "name": "nocturne-notes",
  "productName": "Nocturne Notes",
  "version": "2.5.0",
  "description": "Minimalist note editor",
  "main": "main.js",
  "author": "Nocturne Notes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win --x64 --publish never",
    "verify:visual": "node scripts/verify-ui-lock.js",
    "test:ui": "electron scripts/test-desktop-ui.js",
    "bench:compare": "node scripts/compare-performance.js",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test:load": "electron scripts/test-load.js",
    "test:privacy": "electron scripts/test-privacy-ui.js",
    "test:instance": "node scripts/test-single-instance.js",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:reliability": "electron scripts/test-reliability-ui.js",
    "test:network": "electron scripts/test-network.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "node-gyp": "12.4.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.nocturnenotes.desktop",
    "productName": "Nocturne Notes",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "brand.css",
      "renderer.js",
      "search.js",
      "assets/nocturne-brand-mark.png",
      "assets/nocturne-notes-logo.png",
      "windows-shell.css",
      "preview-api.js",
      "recovery.js",
      "drafts.js",
      "window-shape.js",
      "corner-resize.js",
      "main.js",
      "preload.js",
      "storage.js",
      "package.json",
      "undo-buffer.js",
      "features.css",
      "settings.js",
      "i18n.js",
      "content-policy.js",
      "html-content.js",
      "ipc-contract.js",
      "node_modules/parse5/**/*",
      "node_modules/entities/**/*",
      "cipher-db.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nocturne Notes.exe",
      "icon": "assets/nocturne-notes-refined.ico",
      "signAndEditExecutable": true
    },
    "fileAssociations": [
      {
        "ext": "ns",
        "name": "Nocturne Notes Project",
        "description": "Nocturne Notes project",
        "role": "Editor"
      }
    ],
    "nsis": {
      "artifactName": "Nocturne Notes Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "installerIcon": "assets/nocturne-notes-refined.ico",
      "uninstallerIcon": "assets/nocturne-notes-refined.ico",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "portable": {
      "artifactName": "Nocturne Notes Portable.exe",
      "requestExecutionLevel": "user"
    },
    "extraResources": [
      {
        "from": "native/build/Release/nocturne_cipher.node",
        "to": "nocturne_cipher.node"
      },
      {
        "from": "native/notices",
        "to": "third-party-notices"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.9"
  }
}
